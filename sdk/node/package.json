{
  "name": "@bwbrowser/sdk",
  "version": "0.1.0",
  "description": "Thin client for the BW Browser local REST API",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bw-browser",
    "browser-automation",
    "anti-detect",
    "cdp"
  ],
  "homepage": "https://bwbrowser.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhom/bwbrowser.git",
    "directory": "sdk/node"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
